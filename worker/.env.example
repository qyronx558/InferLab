# Operator-only process environment. This file is not auto-loaded.
INFERLAB_DATABASE_URL=sqlite:///./.local/inferlab.db
# Leave both unset until the owner supplies an approved policy and runner plugin.
# INFERLAB_WORKER_POLICY_FILE=E:\LOCAL-CONFIG\worker-policy.json
# INFERLAB_RUNNER_FACTORY=owner_inferlab.runner:create_runner
# All workers controlling this GPU must share this file and database.
# Defaults to the current user's ~/.inferlab-gpu.lock; never delete an active lock file.
# INFERLAB_GPU_LOCK_FILE=E:\LOCAL-CONFIG\inferlab-gpu.lock
