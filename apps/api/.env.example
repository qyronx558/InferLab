# Explicit database/migration factories read the process environment, not this file.
# The health-only API does not connect to the database on startup.
INFERLAB_DATABASE_URL=sqlite:///./.local/inferlab.db
# PostgreSQL alternative: postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/inferlab
# Put real credentials only in an untracked local environment or process environment.
