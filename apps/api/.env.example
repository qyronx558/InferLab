# Explicit database/migration factories read the process environment, not this file.
# The API opens an engine at startup only when a database URL is explicitly set.
# Run Alembic first; the API never creates/migrates tables automatically.
INFERLAB_DATABASE_URL=sqlite:///./.local/inferlab.db
# PostgreSQL alternative: postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/inferlab
# Put real credentials only in an untracked local environment or process environment.
INFERLAB_CONSOLE_ORIGIN=https://127.0.0.1:5173
# Provision interactively in the process environment; see docs/API.md. No default password.
INFERLAB_ADMIN_PASSWORD_HASH=
