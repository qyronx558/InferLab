{
  "name": "inferlab",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=22.13.0 <23 || >=24 <25",
    "npm": ">=10 <12"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace @inferlab/web",
    "build": "npm run build --workspace @inferlab/web",
    "preview:web": "npm run preview --workspace @inferlab/web",
    "lint": "npm run lint --workspace @inferlab/web",
    "typecheck": "npm run typecheck --workspace @inferlab/web",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "npm run test --workspace @inferlab/web",
    "test:e2e": "npm run test:e2e --workspace @inferlab/web --",
    "contracts:generate": "uv run --locked python scripts/export_contracts.py && node scripts/generate-contract-types.mjs",
    "contracts:check": "uv run --locked python scripts/export_contracts.py --check && node scripts/generate-contract-types.mjs --check"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "prettier": "~3.9.10"
  }
}
